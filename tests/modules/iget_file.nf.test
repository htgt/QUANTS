nextflow_process {

    name "Test Process IRODS_IGET_FILE"
    script "modules/local/irods/iget_file/main.nf"
    process "IRODS_IGET_FILE"

    test("Should run without failures and produce the downloaded file and md5") {

        when {
            params {
                irods_iget_cmd = "${System.getProperty('user.dir')}/tests/bin/iget"
            }
            process {
                """
                input[0] = tuple([id: 'dummy_sample'], '/seq/10754/10754_1#20.cram')
                """
            }
        }

        then {
            assert process.success

            def file_out = process.out.file.get(0)
            def md5_out  = process.out.md5.get(0)
            def ver_out  = process.out.versions.get(0)

            def meta = file_out[0]

            assert snapshot([
                id: meta.id,
                file: new File(file_out[1].toString()).getName(),
                md5:  new File(md5_out[1].toString()).getName(),
                versions: new File(ver_out.toString()).getName()
            ]).match()
        }
    }
}
