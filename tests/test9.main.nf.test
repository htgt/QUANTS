nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run multi-sample paired-end FLASH2 merging, QC, trimming, filtering, and pyquest quantification without failures") {

        def raw = file("${projectDir}/tests/manifests/raw-fastq-pe-multiple-samples9.csv").text
        def resolved = raw.replace(
            "tests/quants-data",
            "${projectDir}/tests/quants-data"
        )   

        def tmpDir = File.createTempDir()
        def resolvedSheet = new File(tmpDir, "raw-fastq-pe-multiple-samples9.resolved.csv")
        resolvedSheet.text = resolved

        when {
            params {
                input = "${resolvedSheet}"
                single_end = false
                input_type = "fastq"
                raw_sequencing_qc = true
                adapter_trimming = "cutadapt"
                primer_trimming = "cutadapt"
                adapter_trimming_qc = true
                primer_trimming_qc = true
                read_merging = "flash2"
                read_merging_qc = true
                read_filtering = "seqkit_seq"
                read_filtering_qc = true
                seqkit_seq_options = "--min-len 227"
                quantification = "pyquest"
                pyquest_library_converter_options = "-N 1 -S 24"
            }
        }

        then {
            assert workflow.success
        }

    }

}
