#!/usr/bin/env bash
set -euo pipefail

# Fake iget for isolation testing:
# Accepts: iget [flags] <remote_path> <local_target>
# Writes <local_target> with dummy content.

args=()
for a in "$@"; do
  if [[ "$a" == -* ]]; then
    continue
  fi
  args+=("$a")
done

if (( ${#args[@]} < 1 )); then
  echo "fake iget: missing remote path" >&2
  exit 2
fi

remote="${args[0]}"
local_target="${args[1]:-$(basename "$remote")}"

echo "Fake iget: $remote -> $local_target" >&2
echo "fake content from $remote" > "$local_target"
