nextflow_pipeline {

    name "Test PE read merging preserves row metadata"
    script "main.nf"

    test("Should preserve appended metadata through paired-end read merging and downsampling") {

        def resolvedSheet = ManifestResolver.resolveSheet(projectDir, "raw-fastq-pe-row-meta.csv")

        when {
            params {
                input = "${resolvedSheet}"
                single_end = false
                input_type = "fastq"
                downsampling = true
                downsampling_size = 1000000
                downsampling_seed = 413
                primer_trimming = "cutadapt"
                read_merging = "flash2"
                read_modification = true
                append_quality = "?"
                outdir = "./results"
            }
        }

        then {
            assert workflow.success

            def appendCommandScripts = []
            def modifiedOutputs = []

            new File("${projectDir}/.nf-test/tests").eachFileRecurse { file ->
                if (file.name == ".command.sh") {
                    def scriptText = file.text
                    if (scriptText.contains("append_start=") && scriptText.contains("append_end=")) {
                        appendCommandScripts << [path: file.path, text: scriptText]
                    }
                }

                if (file.name.endsWith(".modified.fq.gz") && file.path.contains("/results/T1/modified_fastq/")) {
                    modifiedOutputs << file
                }
            }

            assert !appendCommandScripts.isEmpty()

            def appendCmd = appendCommandScripts.max { it.path }
            assert appendCmd.text.contains('append_start="GGACTCTCCAGGACTGCCAT"')
            assert appendCmd.text.contains('append_end="GGACAGAGCAGAGCCCAC"')
            assert !appendCmd.text.contains('append_start="null"')
            assert !appendCmd.text.contains('append_end="null"')

            assert !modifiedOutputs.isEmpty()

            def sortedMatches = modifiedOutputs.sort { -it.lastModified() }
            def output = null
            def header = null
            def sequence = null

            for (candidate in sortedMatches) {
                if (candidate.length() == 0L) {
                    continue
                }

                def parsedHeader = null
                def parsedSequence = null
                new BufferedReader(
                    new InputStreamReader(
                        new java.util.zip.GZIPInputStream(new FileInputStream(candidate)),
                        "UTF-8"
                    )
                ).withCloseable { reader ->
                    parsedHeader = reader.readLine()
                    parsedSequence = reader.readLine()
                }

                if (parsedHeader != null && parsedSequence != null) {
                    output = candidate
                    header = parsedHeader
                    sequence = parsedSequence
                    break
                }
            }

            if (output != null) {
                assert header.startsWith("@")
                assert sequence.startsWith("GGACTCTCCAGGACTGCCAT")
                assert sequence.endsWith("GGACAGAGCAGAGCCCAC")
                assert !sequence.contains("null")
            }

            sortedMatches.each { candidate ->
                def fullText = ""
                new BufferedReader(
                    new InputStreamReader(
                        new java.util.zip.GZIPInputStream(new FileInputStream(candidate)),
                        "UTF-8"
                    )
                ).withCloseable { reader ->
                    def lines = []
                    def line
                    while ((line = reader.readLine()) != null) {
                        lines << line
                    }
                    fullText = lines.join("\n")
                }
                assert !fullText.contains("null")
            }
        }

    }
}
