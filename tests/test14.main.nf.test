nextflow_process {

    name "Test SEQTK_SAMPLE process"
    script "modules/local/seqtk/sample/main.nf"
    process "SEQTK_SAMPLE"

    test("Should successfully downsample single-end and paired-end reads with SEQTK_SAMPLE") {
        when {
            params {
                downsampling = true
                downsampling_size = 1000000
                downsampling_seed = 413
            }

            process {
                """
                input[0] = Channel.of([["id":"test_sample", "single_end":"true"], file("${projectDir}/tests/quants-data/sample-data/2.fq.gz", checkIfExists: true)])
                """
            }
        }

        then {
            assert process.success
            assert process.out.reads[0][1].toString().endsWith("test_sample_downsampled.fq.gz")
        }
    }

    test("Validate paired-end downsampling") {
        when {
            params {
                downsampling = true
                downsampling_size = 1000000
                downsampling_seed = 413
            }

            process {
                """
                input[0] = Channel.of([
                    ["id":"test_sample", "single_end":"false"],
                    [
                        file("${projectDir}/tests/quants-data/sample-data/xR1.fq.gz", checkIfExists: true),
                        file("${projectDir}/tests/quants-data/sample-data/xR2.fq.gz", checkIfExists: true)
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert process.out.reads[0][1].collect { it.toString().tokenize('/').last() } == [
                "test_sample_downsampled_1.fq.gz",
                "test_sample_downsampled_2.fq.gz"
            ]
        }
    }
}
