nextflow_pipeline {

    name "Test main.nf exits when given invalid downsampling parameters"
    script "main.nf"

    test("Should fail when downsampling is enabled and downsampling_size is not an integer") {

        def raw = file("${projectDir}/tests/manifests/raw-fastq-se.csv").text
        def resolved = raw.replace(
            "tests/quants-data",
            "${projectDir}/tests/quants-data"
        )

        def tmpDir = File.createTempDir()
        def resolvedSheet = new File(tmpDir, "raw-fastq-se.resolved.csv")
        resolvedSheet.text = resolved

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                downsampling = true
                downsampling_size = "not_an_integer"
                downsampling_seed = 413
            }
        }

        then {
            assert workflow.failed
        }

    }
}
