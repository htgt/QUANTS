nextflow_pipeline {

    name "Test main.nf exits when given invalid downsampling parameters"
    script "main.nf"

    test("Should fail when downsampling_size is not an integer") {

        when {
            params {
                input = "${projectDir}/tests/manifests/raw-fastq-se.csv"
                single_end = true
                input_type = "fastq"
                downsampling = true
                downsampling_size = "1000000"
                downsampling_seed = 413
            }
        }

        then {
            assert workflow.failed
        }

    }
}
