nextflow_pipeline {
    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures with transform_library enabled") {

        def raw = file("${projectDir}/tests/manifests/trimmed-fastq-se1.csv").text
        def resolved = raw.replace(
            "tests/quants-data",
            "${projectDir}/tests/quants-data"
        )

        def tmpDir = File.createTempDir()
        def resolvedSheet = new File(tmpDir, "trimmed-fastq-se1.resolved.csv")
        resolvedSheet.text = resolved

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                read_modification = true
                append_quality = "?"
                transform_library = true
                pyquest_library_converter_options = "-N 1 -S 24"
                quantification = "pyquest"
            }
        }
        then {
            assert workflow.success
        }
    }
}