nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures with raw_sequencing_qc enabled") {

        def resolvedSheet = ManifestResolver.resolveSheet(projectDir, "trimmed-fastq-se2.csv")

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                raw_sequencing_qc = true
                read_modification = true
                append_quality = "?"
                quantification = "pyquest"
                pyquest_library_converter_options = "-N 1 -S 24"
            }
        }

        then {
            assert workflow.success
        }

    }

}
