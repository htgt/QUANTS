nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failure single-end QC, trimming, read modification, and pyquest quantification with no read transformation") {

        def raw = file("${projectDir}/tests/manifests/raw-fastq-se-noRC.csv").text
        def resolved = raw.replace(
            "tests/quants-data",
            "${projectDir}/tests/quants-data"
        )

        def tmpDir = File.createTempDir()
        def resolvedSheet = new File(tmpDir, "raw-fastq-se-noRC.resolved.csv")
        resolvedSheet.text = resolved

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                raw_sequencing_qc = true
                adapter_trimming = "cutadapt"
                adapter_trimming_qc = true
                primer_trimming = "cutadapt"
                primer_trimming_qc = true
                read_modification = true
                append_quality = "?"
                transform_library = true
                pyquest_library_converter_options = "-N 1 -S 24"
                quantification = "pyquest"
            }
        }

        then {
            assert workflow.success
        }

    }

}
