nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run multi-sample single-end QC, adapter trimming, and primer trimming without failures") {

        def raw = file("${projectDir}/tests/manifests/raw-fastq-se-multiple-samples10.csv").text
        def resolved = raw.replace(
            "tests/quants-data",
            "${projectDir}/tests/quants-data"
        )   

        def tmpDir = File.createTempDir()
        def resolvedSheet = new File(tmpDir, "raw-fastq-se-multiple-samples10.resolved.csv")
        resolvedSheet.text = resolved

        when {
            params {
                input = "${resolvedSheet}"
                single_end = true
                input_type = "fastq"
                raw_sequencing_qc = true
                adapter_trimming = "cutadapt"
                adapter_trimming_qc = true
                primer_trimming = "cutadapt"
                primer_trimming_qc = true
            }
        }

        then {
            assert workflow.success
        }

    }

}
