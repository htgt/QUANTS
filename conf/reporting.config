// conf/reporting.config
// Standardised reporting for CI-friendly QUANTS runs

def runId = System.getenv('RUN_ID') ?: workflow.sessionId

report {
  enabled   = true
  file      = "${params.outdir}/reports/${runId}.report.html"
  overwrite = true
}

trace {
  enabled   = true
  file      = "${params.outdir}/reports/${runId}.trace.tsv"
  fields    = 'task_id,process,tag,status,exit,attempt,cpus,memory,duration,realtime,pcpu,pmem,rss,vmem,container,workdir'
  sep       = '\t'
  header    = true
  overwrite = true
}

ansi { log = false }