// conf/reports.config
// Standardised reporting for CI-friendly QUANTS runs

report {
  enabled   = true
  overwrite = true
}

trace {
  enabled   = true
  fields    = 'task_id,process,tag,name,status,exit,attempt,cpus,time,memory,duration,realtime,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,container,workdir'
  sep       = '\t'
  header    = true
  overwrite = true
}

ansi { log = false }